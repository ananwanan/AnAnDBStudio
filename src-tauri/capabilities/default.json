{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal IPC permissions for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-app-info",
    "allow-check-ipc-protocol",
    "allow-open-sqlite-connection",
    "allow-list-sqlite-connections",
    "allow-close-sqlite-connection",
    "allow-get-sqlite-schema",
    "dialog:allow-open",
    "allow-start-sqlite-query",
    "allow-poll-sqlite-query",
    "allow-cancel-sqlite-query"
  ]
}
